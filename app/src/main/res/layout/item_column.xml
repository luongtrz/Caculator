<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
    app:cardCornerRadius="@dimen/corner_md"
    app:cardElevation="2dp"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_column_number"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="40dp"
            android:background="@color/md_theme_primary"
            android:gravity="center"
            android:text="Cột 1"
            android:textColor="@color/md_theme_onPrimary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_weight_1"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="@dimen/weight_cell_height"
            android:background="@drawable/bg_weight_cell"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:hint="—"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:textSize="@dimen/weight_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_weight_2"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="@dimen/weight_cell_height"
            android:background="@drawable/bg_weight_cell"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:hint="—"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:textSize="@dimen/weight_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_weight_3"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="@dimen/weight_cell_height"
            android:background="@drawable/bg_weight_cell"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:hint="—"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:textSize="@dimen/weight_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_weight_4"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="@dimen/weight_cell_height"
            android:background="@drawable/bg_weight_cell"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:hint="—"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:textSize="@dimen/weight_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_weight_5"
            android:layout_width="@dimen/weight_cell_width"
            android:layout_height="@dimen/weight_cell_height"
            android:background="@drawable/bg_weight_cell"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:hint="—"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:textSize="@dimen/weight_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_column_total"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_column_total"
            android:gravity="center"
            android:text="0.0 kg"
            android:textColor="@color/md_theme_onPrimary"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
