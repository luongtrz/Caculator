<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/md_theme_surface">

    <TextView
        android:id="@+id/tv_import_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📥 Nhận đợt cân từ mã QR"
        android:textAppearance="@style/TextAppearance.Rice.Headline"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="@dimen/text_title"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <TextView
        android:id="@+id/tv_import_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm thấy 1 đợt cân hợp lệ:"
        android:textAppearance="@style/TextAppearance.Rice.Body"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- Container for scrollable list of records preview -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp"
        android:layout_marginBottom="@dimen/spacing_md">

        <LinearLayout
            android:id="@+id/layout_import_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_import"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="Hủy"
            android:layout_marginEnd="@dimen/spacing_sm"
            style="@style/Widget.Rice.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_import"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="Nhập vào máy"
            style="@style/Widget.Rice.Button.Primary" />
    </LinearLayout>

</LinearLayout>
