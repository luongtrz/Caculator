<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_history"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <!-- Toolbar: app icon + title + date subtitle + sync badge + settings -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Lịch sử"
            app:titleTextColor="@color/md_theme_onPrimary"
            app:subtitle=""
            app:subtitleTextColor="@color/md_theme_primaryContainer"
            android:background="@color/md_theme_primary">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/spacing_xs">

                <!-- Normal mode buttons -->
                <LinearLayout
                    android:id="@+id/layout_normal_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Scan QR Button -->
                    <ImageButton
                        android:id="@+id/btn_scan_qr"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_qr_scanner"
                        android:contentDescription="Quét mã QR"
                        app:tint="@color/md_theme_onPrimary" />

                    <!-- Multi-select toggle button -->
                    <ImageButton
                        android:id="@+id/btn_enter_select"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_checklist"
                        android:contentDescription="Chọn chia sẻ"
                        app:tint="@color/md_theme_onPrimary" />

                    <!-- Settings / Info button -->
                    <FrameLayout
                        android:id="@+id/btn_settings"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_white"
                            android:contentDescription="Thông tin"
                            app:tint="@color/md_theme_onPrimary" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Selection mode actions -->
                <LinearLayout
                    android:id="@+id/layout_selection_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả"
                        android:textColor="@color/md_theme_onPrimary"
                        android:textSize="@dimen/text_body"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingBottom="@dimen/spacing_xs"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_cancel_selection"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close_white"
                        android:contentDescription="Hủy chọn"
                        app:tint="@color/md_theme_onPrimary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Search bar inside AppBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Tìm theo tên khách hàng..."
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:textColorHint="@color/md_theme_onSurfaceVariant"
                android:textColor="@color/md_theme_onSurface"
                android:singleLine="true"
                android:textSize="@dimen/text_body"
                android:imeOptions="actionSearch"
                android:inputType="textFilter" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Chưa có đợt cân nào.\nNhấn ＋ Thêm mới để bắt đầu."
        android:textSize="@dimen/text_body"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- Record list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

    <!-- Bottom container for Add new session or Share Selected QR -->
    <FrameLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md">

        <!-- Normal: Add new session button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_add_session"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="＋  Thêm mới"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold"
            style="@style/Widget.Rice.Button.Primary" />

        <!-- Selection Mode: Share QR button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_selected_qr"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="Tạo mã QR chia sẻ (0)"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart"
            android:visibility="gone"
            style="@style/Widget.Rice.Button.Primary" />
    </FrameLayout>

</LinearLayout>
